# Copy to .env and fill in your own values. Never commit .env.
OPENROUTER_API_KEY=
GROQ_API_KEY=
TAVILY_API_KEY=
# SEC requires a User-Agent with contact info for EDGAR downloads, e.g. "FinSight research you@example.com"
SEC_USER_AGENT=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=finsight

# ---- Optional FinSight overrides (defaults are all FREE; see src/finsight/config.py) ----
# Zero-cost policy: OpenRouter models must end in ":free" unless this is true.
# FINSIGHT_ALLOW_PAID=false
# Per-role provider/model (groq | openrouter):
# FINSIGHT_ROUTER_PROVIDER=groq
# FINSIGHT_ROUTER_MODEL=openai/gpt-oss-20b
# FINSIGHT_AGENT_PROVIDER=groq
# FINSIGHT_AGENT_MODEL=qwen/qwen3.8-27b          # preview; fallback: openai/gpt-oss-120b
# FINSIGHT_REPORT_PROVIDER=groq
# FINSIGHT_REPORT_MODEL=openai/gpt-oss-120b
# OpenRouter free alternative (50 requests/day without purchased credits):
# FINSIGHT_AGENT_PROVIDER=openrouter
# FINSIGHT_AGENT_MODEL=nvidia/nemotron-3.5-super-vl:free
